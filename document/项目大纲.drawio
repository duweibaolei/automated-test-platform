        <mxCell id="RqreJTc5_sZXbgilrUmd-51" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;五层架构总览&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1.外部触发层 — 双模式驱动&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; Git Webhook（变更驱动自动闭环）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; 用户操作（手动录入触发）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;2.前端层 — Vue 3 + TypeScript + Ant Design Vue&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; Pinia 状态管理 + Axios HTTP 拦截器 + Vue Router 守卫&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;3. Java 后端层 — Spring Boot 3.4 · 9 个 Maven 子模块&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; 严格分层：admin → web → service → dao → model → common（单向向下）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; 三大集成客户端：gRPC Client（→C）、AI Client（→Python）、MQ Producer（→Playwright）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;4.跨语言服务层&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; Python AI：FastAPI + MasterAgent 编排 5 个 Sub-Agent（Risk/Summary/RootCause/CaseGen/SemanticMatch）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; C Engine：C++17 gRPC Server + extern &quot;C&quot; Bridge + C17 业务逻辑（diff_engine / impact_analyzer / dependency_graph）&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;5.存储与中间件层 — MySQL（39 表 6 域）/ Redis / RabbitMQ / MinIO / Milvus&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;6.执行节点 — Playwright 浏览器自动化（MQ 异步分发/回传）&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
