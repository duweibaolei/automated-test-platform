<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        automated-test-platform-mq 消息队列模块
        包含: RabbitMQ配置 生产者 消费者 消息DTO
        Contains: RabbitMQ config, producers, consumers, message DTOs
    -->

    <parent>
        <groupId>com.dwl</groupId>
        <artifactId>automated-test-platform-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>automated-test-platform-mq</artifactId>
    <packaging>jar</packaging>
    <name>Automated Test Platform Server</name>
    <description>消息队列模块 - RabbitMQ配置、生产者、消费者、消息DTO</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!--
            内部模块
            Internal Modules
        -->
        <dependency>
            <groupId>com.dwl</groupId>
            <artifactId>automated-test-platform-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dwl</groupId>
            <artifactId>automated-test-platform-model</artifactId>
        </dependency>

        <!-- Spring AMQP
             RabbitMQ
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Jackson JSON
             消息序列化 与跨语言契约对齐
             Message serialization and cross-language contract alignment
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!--
            Lombok
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>


</project>