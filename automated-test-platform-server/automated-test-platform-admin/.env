# ============================================================
# Spring 环境配置
# ============================================================
# 可选值: dev(开发环境), prod(生产环境)
# 默认读取 application.yml 中的配置，若未指定则默认为 dev
SPRING_PROFILES_ACTIVE=dev

# ============================================================
# 数据库配置(MySQL)
# ============================================================
# 主机地址(默认: localhost)
MYSQL_HOST=localhost
# 端口(默认: 3306)
MYSQL_PORT=3306
# 数据库名称(默认: self-delta-test)
MYSQL_DB=self-delta-test
# 用户名(默认: root)
MYSQL_USER=root
# 密码(默认: )
MYSQL_PASSWORD=

# ============================================================
# Redis 配置
# ============================================================
# 主机地址(默认: localhost)
REDIS_HOST=localhost
# 端口(默认: 6379)
REDIS_PORT=6379
# 密码(默认为空)
REDIS_PASSWORD=
# 数据库索引(默认: 0)
REDIS_DB=0

# ============================================================
# 消息队列配置(RabbitMQ)
# ============================================================
# 主机地址(默认: localhost)
RABBITMQ_HOST=localhost
# 端口(默认: 5672)
RABBITMQ_PORT=5672
# 用户名(默认: guest)
RABBITMQ_USER=guest
# 密码(默认: guest)
RABBITMQ_PASSWORD=guest
# 虚拟主机(默认: /)
RABBITMQ_VHOST=/

# ============================================================
# 安全配置(JWT)
# ============================================================
# JWT 密钥(生产环境务必修改为复杂的随机字符串)
# 默认值: self-delta-test-default-secret-key-must-be-at-least-256-bits-long-for-hmac-sha
JWT_SECRET=self-delta-test-default-secret-key-must-be-at-least-256-bits-long-for-hmac-sha
# 过期时间(毫秒, 默认: 86400000 即 24小时)
JWT_EXPIRATION=86400000

# ============================================================
# AI 服务配置
# ============================================================
# AI 服务地址(默认: http://localhost:8000)
AI_SERVICE_URL=http://localhost:8000
# 连接超时时间(秒, 默认: 5)
AI_SERVICE_CONNECT_TIMEOUT=5
# 读取超时时间(秒, 默认: 60)
AI_SERVICE_READ_TIMEOUT=60

# ============================================================
# 跨域配置(CORS)
# ============================================================
# 允许的域名(默认: * 即允许所有)
CORS_ALLOWED_ORIGINS=*

# ============================================================
# 生产环境特有配置(仅在 SPRING_PROFILES_ACTIVE=prod 时需要)
# ============================================================
# gRPC 信任证书路径(生产环境)
GRPC_TRUST_CERT_PATH=